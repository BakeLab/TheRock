From 22bced9820c698c47dd1c722c9fcb86cceaf346d Mon Sep 17 00:00:00 2001
From: cyy <cyyever@outlook.com>
Date: Sun, 15 Nov 2026 09:52:52 +0800
Subject: [PATCH] hipcc: detect filesystem linker requirements

Probe the filesystem API used by hipcc and hipconfig before adding a compatibility library. Modern standard libraries do not provide or require a separate libstdc++fs.so.

Assisted-by: Codex:GPT-6-astra
---
 amd/hipcc/CMakeLists.txt | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/amd/hipcc/CMakeLists.txt b/amd/hipcc/CMakeLists.txt
index 13714de..bb65026 100644
--- a/amd/hipcc/CMakeLists.txt
+++ b/amd/hipcc/CMakeLists.txt
@@ -24,8 +24,26 @@ option(BUILD_SHARED_LIBS "Build using shared libraries" ON)
 set(CMAKE_CXX_STANDARD 17)
 set(CMAKE_CXX_STANDARD_REQUIRED True)
 
-set(ADDITIONAL_SHARED_LIBRARIES_TO_LINK
-  libstdc++fs.so)
+set(ADDITIONAL_SHARED_LIBRARIES_TO_LINK "")
+if(NOT WIN32)
+  include(CheckCXXSourceCompiles)
+  include(CMakePushCheckState)
+  cmake_push_check_state(RESET)
+  set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_SOURCE_DIR}/src")
+  set(_filesystem_test "#include <filesystem.h>
+int main() { return fs::current_path().empty(); }")
+  check_cxx_source_compiles("${_filesystem_test}" HIPCC_FILESYSTEM_BUILTIN)
+  if(NOT HIPCC_FILESYSTEM_BUILTIN)
+    set(CMAKE_REQUIRED_LIBRARIES stdc++fs)
+    check_cxx_source_compiles("${_filesystem_test}" HIPCC_FILESYSTEM_STDCXXFS)
+    if(NOT HIPCC_FILESYSTEM_STDCXXFS)
+      message(FATAL_ERROR "C++ filesystem cannot link with the standard library or stdc++fs")
+    endif()
+    set(ADDITIONAL_SHARED_LIBRARIES_TO_LINK stdc++fs)
+  endif()
+  unset(_filesystem_test)
+  cmake_pop_check_state()
+endif()
 
 set(HIPCC_BIN
   hipcc)
@@ -43,13 +61,11 @@ set(HIPCONFIG_SOURCES
 
 add_executable(${HIPCC_BIN} ${HIPCC_SOURCES})
 if(NOT WIN32)
-  # C++17 does not require std lib linking.
   target_link_libraries(${HIPCC_BIN} ${ADDITIONAL_SHARED_LIBRARIES_TO_LINK})
 endif()
 
 add_executable(${HIPCONFIG_BIN} ${HIPCONFIG_SOURCES})
 if(NOT WIN32)
-  # C++17 does not require std lib linking.
   target_link_libraries(${HIPCONFIG_BIN} ${ADDITIONAL_SHARED_LIBRARIES_TO_LINK})
 endif()
 
